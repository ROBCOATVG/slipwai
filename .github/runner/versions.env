# The toolchains the CI job image carries, and the only place their numbers are written.
#
# `build.sh` sources this and passes each value to the Dockerfile as a `--build-arg`; the image's
# `check-toolchains.sh` sources the same file and holds the running image to it. So a toolchain bump is one
# edit here, a rebuild, a retag and a runner restart — and an image that drifts from this file fails the
# first job that runs, by name and version, instead of being discovered by whatever breaks downstream.
#
# Each SHA256 is the one the publisher lists for the exact archive named below. They are checked at build
# time, so a substituted tarball fails the build rather than the runners.

# python-build-standalone: a relocatable CPython that carries its own pip and venv, so nothing is taken from
# Ubuntu's python3 (which is 3.12, and which apt's own tooling depends on — see the Dockerfile).
PYTHON_VERSION=3.13.15
PYTHON_BUILD=20260901
PYTHON_SHA256=0651dd7157d3debf769e15a52c1de9de7fbcdc36ba72faf79fde3c44f14d9461

# The base image bundles a node of its own, older than this one. The Dockerfile puts this one earlier on
# PATH, and `check-toolchains.sh` is what notices if that ever stops being true.
NODE_VERSION=24.20.0
NODE_SHA256=2f2c0da162318f0de47665410c7c8c2ed3d36c8f3105de4bbc61176c70a7cbf2

GO_VERSION=1.27.1
GO_SHA256=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445

# Temurin names a release three ways: the tag, the file, and what `java -version` prints. All three are
# written out because deriving one from another is a guess that breaks on the next patch release.
JAVA_VERSION=25.0.4.1
JAVA_RELEASE=jdk-25.0.4.1+1
JAVA_ARCHIVE=25.0.4.1_1
JAVA_SHA256=dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e

TOFU_VERSION=1.12.6
TOFU_SHA256=5dc43da4f750f33873dc25e94587128709e819e544b7be9016b255316153c3a8

KO_VERSION=0.19.1
KO_SHA256=635ac6ea3fd376c935fee597fbb29ab2c2449f49ef1655085fe3aa9c25fed7a5

PACK_VERSION=0.40.9
PACK_SHA256=dc0ee1e931cf8a106d7555a01a214864f9acb60b77adf15d69b74df4404758e9
