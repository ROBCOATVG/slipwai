# Configuration comes from the environment (twelve-factor). This file is a local convenience; real
# environments supply values directly and .env is git-ignored. Copy it to .env to use these values.
NODE_ENV=development
# How this service logs. The service logs structured records from the first run; LOG_FORMAT decides
# whether they come out as JSON — what a log shipper reads, and the default everywhere but a
# terminal — or as one readable line each, which is what `make dev` sets.
LOG_LEVEL=info
LOG_FORMAT=json
# backing-service:__TRANSPORT__:begin
#
# The transport's own configuration. PUBLIC_BASE_URL is the address callers reach this service on, which is
# not derivable from PORT — behind a proxy or a tunnel they differ, and anything that builds a link (a
# redirect URI, a webhook target) needs the outside one.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
#
# Which browser origins may call this service cross-origin. Empty — the default, and what this file
# deliberately leaves it as — is same-origin only: no CORS headers are sent to anyone, which is the right
# answer for `make dev` and `make demo`, where the browser app is served from its own origin and the dev
# server forwards `/api` to this one. Set it, comma-separated, only for a deployment where the app really
# is on another origin, and name that origin exactly.
#
#   CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=
#
# Where to send traces. Unset — the default — means spans are still recorded and still give every log line
# and every event a trace id; nothing is shipped anywhere and nothing is listened for. Point it at an OTLP
# collector to start exporting: the service starts either way, and a collector that is down is a warning
# rather than a failure to boot.
#
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# backing-service:__TRANSPORT__:end
# backing-service:sqlite:begin
#
# Where the event log lives. A path, not a URL: SQLite is a file this process opens, with no server to
# address. Keep it out of the repository — .gitignore already refuses *.sqlite3 — and remember that
# deleting it deletes the entire truth of an event-sourced system.
EVENT_STORE_PATH=./events.sqlite3
# backing-service:sqlite:end
# backing-service:postgres:begin
#
# POSTGRES_PORT is read by Docker Compose, not by the application, so a second project on this machine can
# move a host port without editing docker-compose.yml. Moving it means moving the port inside DATABASE_URL
# in the same edit — nothing derives one from the other.
POSTGRES_PORT=5433
DATABASE_URL=postgres://app:app@localhost:5433/app
# backing-service:postgres:end
# backing-service:keycloak|users-keycloak:begin
#
# KEYCLOAK_PORT is Compose's rather than the application's: the host port of the one Keycloak container,
# which serves every realm below. Moving it means moving the port inside each issuer URL in the same edit.
KEYCLOAK_PORT=8081
# backing-service:keycloak|users-keycloak:end
# backing-service:keycloak:begin
#
# Staff identity. Every OIDC_* value matches docker/keycloak/realms/app.json, so the issuer resolves with no
# console steps. The client secret is a local fixture published on purpose — see docker/keycloak/README.md.
OIDC_ISSUER=http://localhost:8081/realms/app
OIDC_CLIENT_ID=app-local
OIDC_CLIENT_SECRET=local-only-not-a-real-secret
# The claim the groups arrive in: Keycloak's mapper writes `groups`, Cognito writes `cognito:groups`.
OIDC_GROUPS_CLAIM=groups
OIDC_GROUP_ADMIN=app-admin
OIDC_GROUP_OPERATOR=app-operator
OIDC_GROUP_VIEWER=app-viewer
# backing-service:keycloak:end
# backing-service:users-keycloak:begin
#
# Customer identity: the `customers` realm in docker/keycloak/realms/customers.json. USERS_OIDC_* is what a
# service validates a customer's bearer token against — the issuer, and the audience the realm stamps into
# tokens for it. VITE_USERS_* is what the browser app's login uses: Vite exposes only VITE_-prefixed values to
# the bundle, and the client is public, so there is no secret here to keep out of it.
USERS_OIDC_ISSUER=http://localhost:8081/realms/customers
USERS_OIDC_AUDIENCE=api
VITE_USERS_ISSUER=http://localhost:8081/realms/customers
VITE_USERS_CLIENT_ID=web
# backing-service:users-keycloak:end
