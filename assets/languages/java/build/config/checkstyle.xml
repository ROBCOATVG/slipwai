<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter"/>
  <module name="RegexpSingleline">
    <property name="format" value="\s+$"/>
    <property name="message" value="trailing whitespace"/>
  </module>

  <!--
    A line's length is about how readable the code is, so the two kinds of line whose length nobody here
    chose are exempt: a URL in a comment, and a `package` or `import` declaration.

    The import exemption is not a convenience — it is what keeps this gate measuring the code rather than
    the project's name. A package is `com.example.<project>`, so every deep import grows with however many
    characters the project is called, and a name a few letters longer turns a file that was fine into a
    failure nobody can fix without renaming the project or flattening the package layout. Checkstyle's own
    bundled configurations exempt both for the same reason.
  -->
  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern" value="^\s*(//|\*) *https?://|^\s*(package|import) "/>
  </module>

  <module name="TreeWalker">
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport">
      <property name="allowStaticMemberImports" value="true"/>
    </module>
    <module name="PackageName"/>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="ConstantName"/>
    <module name="NeedBraces"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>
    <module name="WhitespaceAfter"/>
    <module name="NoWhitespaceBefore"/>
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="MissingSwitchDefault"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="OneTopLevelClass"/>
    <module name="UpperEll"/>
    <module name="ModifierOrder"/>
  </module>
</module>
