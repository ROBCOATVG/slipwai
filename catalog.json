          ],
          "containers": [
            "keycloak"
          ],
          "migrations": false,
          "integration-suite": false,
          "label": "Keycloak \u2014 a customers realm beside the staff realm in the same container, self-registration and password reset on, a public PKCE client for the browser app; the browser login is real, and a service's token validation is the framework's where one owns startup and NOT implemented where none does",
          "features": [
            "users-keycloak"
          ],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
          "targets": [
            "none",
            "existing"
          ]
        },
        "cognito": {
          "capabilities": [
            "users-cognito"
          ],
          "containers": [
            "keycloak"
          ],
          "migrations": false,
          "integration-suite": false,
          "label": "Cognito \u2014 a second user pool for the product's users with self-registration and a public PKCE client, provisioned in AWS; Keycloak's customers realm runs locally as the stand-in, and the browser login is real",
          "features": [
            "users-keycloak"
          ],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
          "targets": [
            "aws"
          ],
          "aws": {
            "provisions": "cognito"
          }
        },
        "auth0": {
          "capabilities": [
            "users-auth0"
          ],
          "containers": [
            "keycloak"
          ],
          "migrations": false,
          "integration-suite": false,
          "label": "Auth0 \u2014 a database connection with self-registration and password reset, and a public PKCE client for the browser app, provisioned through Auth0's own Management API rather than by the cloud; Keycloak's customers realm is the local stand-in, and the browser login is real",
          "features": [
            "users-keycloak"
          ],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
