  "axes": {
    "event-store": {
      "prompt": "Event store",
      "description": "Where events live. Every answer is an append-only log behind one port, and the in-memory adapter ships with all of them, so `make verify` needs no Docker whichever store is chosen",
      "profiles": [
        "event-modelling"
      ],
      "absent": "memory",
      "always": [
        "memory"
      ],
      "options": {
        "memory": {
          "capabilities": [
            "event-store-memory"
          ],
          "containers": [],
          "migrations": false,
          "integration-suite": false,
          "label": "In-memory \u2014 zero infrastructure, loses all truth on restart. The adapter the port's contract runs against in `make verify`",
          "features": [],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
          "targets": [
            "none",
            "existing",
            "aws",
            "azure"
          ]
        },
        "sqlite": {
          "capabilities": [
            "event-store-sqlite"
          ],
          "containers": [],
          "migrations": false,
          "integration-suite": false,
          "label": "SQLite \u2014 a real append-only log in one file, no container. Serialised writes, so it cannot prove concurrent behaviour",
          "features": [
            "sqlite"
          ],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
          "targets": [
            "none",
            "existing"
          ]
        },
        "postgres": {
          "capabilities": [
            "event-store-postgres"
          ],
          "containers": [
            "postgres"
          ],
          "migrations": true,
          "integration-suite": true,
          "label": "Postgres \u2014 append-only table, unique (stream, version) as the concurrency control",
          "features": [
            "postgres"
          ],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
          "targets": [
            "none",
            "existing",
            "aws",
            "azure"
          ],
          "aws": {
            "provisions": "rds"
          },
          "azure": {
            "provisions": "flexible-server"
          }
        }
      }
    },
