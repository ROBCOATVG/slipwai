          ],
          "containers": [
            "keycloak"
          ],
          "migrations": false,
          "integration-suite": false,
          "label": "Keycloak \u2014 self-hosted OIDC, container and group mapping scaffolded (the flow itself is NOT implemented)",
          "features": [
            "keycloak"
          ],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
