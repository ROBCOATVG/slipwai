          ],
          "containers": [
            "keycloak"
          ],
          "migrations": false,
          "integration-suite": false,
          "label": "Cognito \u2014 a user pool with the staff groups, a hosted login and a confidential client, provisioned in AWS; Keycloak runs locally as the stand-in, with the same groups and OIDC_* keys (the flow itself is NOT implemented)",
          "features": [
            "keycloak"
