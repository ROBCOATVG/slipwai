    "auth": {
      "prompt": "Staff authentication",
      "description": "Who authenticates staff. Every provider on this axis is an OIDC issuer and OIDC is what the adapters speak, so the protocol is the one thing every answer has in common \u2014 which is why the axis is named for the role and not for it",
      "profiles": [
        "standard",
        "event-modelling"
      ],
      "absent": "none",
      "requires": [
        "http"
      ],
      "options": {
        "none": {
          "capabilities": [],
          "containers": [],
          "migrations": false,
          "integration-suite": false,
          "label": "None \u2014 no staff identity yet",
          "features": [],
          "backends": [
            "typescript",
            "python",
            "go",
            "java-quarkus",
            "java-spring"
          ],
          "targets": [
            "none",
