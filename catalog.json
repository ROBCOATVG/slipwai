  "extensions": {
    "codegraph": {
      "name": "CodeGraph",
      "description": "Indexes the codebase into a local knowledge graph your coding agent can query over MCP, so it can trace callers, dependencies, and the blast radius of a change across files.",
      "ignore": ".codegraph/\n"
    },
    "sonar": {
      "name": "Sonar",
      "description": "Adds an on-demand SonarQube or SonarCloud scan for centralized quality and coverage reporting without changing the local verification gate.",
      "ignore": ".scannerwork/\n.coverage\ncoverage.xml\nsonar-coverage.out\n"
    }
  },
  "profiles": {
    "standard": {
      "tier": 1,
      "label": "Standard \u2014 walking skeleton, executable test and the CD gate, over state-stored persistence. The cheaper start and the irreversible one: cost compounds as one aggregate accretes every new feature, and history you never recorded cannot be recovered. For a tool, a spike, an internal script \u2014 anything whose expected lifespan is short",
      "capabilities": [
        "continuous-delivery"
      ]
    },
    "event-modelling": {
      "tier": 2,
      "label": "Event Modeling \u2014 everything above, plus events as the source of truth, built one stamped slice at a time. Cost per slice stays flat as the system grows, and folding the log back down into tables stays available. Recommended for a product a team will grow for years",
      "extends": "standard",
      "capabilities": [
        "continuous-delivery",
        "event-modelling",
        "event-sourcing"
      ],
      "indivisible": [
        "event-modelling",
        "event-sourcing"
      ]
    }
  }
}
