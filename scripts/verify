#!/bin/sh
set -eu
# The factory's own gate, in the shape it hands a generated Python project: the tooling is pinned in
# requirements-dev.txt, installed on demand into an ignored .python-tools, and never installed twice.
# `make verify` drives this; the modes exist so a single gate can be run one piece at a time.
if [ ! -d .python-tools/ruff ] || [ ! -d .python-tools/mypy ]; then
  python3 -m pip install --disable-pip-version-check -q --target .python-tools -r requirements-dev.txt
fi
case "${1:-all}" in
  --install-only) exit 0 ;;
  --lint-only) PYTHONPATH=.python-tools python3 -m ruff check src scripts tests ;;
  --format-only) PYTHONPATH=.python-tools python3 -m ruff format --check src scripts tests ;;
  --typecheck-only) PYTHONPATH=.python-tools python3 -m mypy ;;
  all)
    PYTHONPATH=.python-tools python3 -m ruff check src scripts tests
    python3 -m compileall -q src scripts tests
    PYTHONPATH=.python-tools python3 -m mypy
    ;;
  *) echo "unknown verify mode: $1" >&2; exit 2 ;;
esac
