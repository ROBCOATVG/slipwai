<?xml version="1.0" encoding="UTF-8"?>
<project name="Ward_Board" default="jar" basedir=".">
    <description>Builds, tests, and runs the project Ward Board.</description>
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <path id="classpath">
        <fileset dir="lib" includes="*.jar"/>
    </path>
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
    <target name="compile">
        <mkdir dir="${build.dir}/classes"/>
        <javac srcdir="${src.dir}" destdir="${build.dir}/classes" source="1.8" target="1.8"
               includeantruntime="false" classpathref="classpath" debug="true"/>
    </target>
    <target name="jar" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/Ward_Board.jar" basedir="${build.dir}/classes">
            <manifest>
                <attribute name="Main-Class" value="Board"/>
            </manifest>
        </jar>
    </target>
    <target name="run" depends="jar">
        <java jar="${dist.dir}/Ward_Board.jar" fork="true"/>
    </target>
</project>
